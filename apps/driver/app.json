{
  "expo": {
    "name": "RideZW Driver",
    "slug": "ridezwdriver",
    "owner": "chesa-pride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash.png",
    "userInterfaceStyle": "light",
    "scheme": "ridezw-driver",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "zw.ridezw.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RideZW Driver requires location access to match nearby rides and navigate routes."
      }
    },
    "android": {
      "package": "zw.ridezw.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "829373c8-b9ab-4f01-9709-963f93ffd2d4"
      }
    }
  }
}
