# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# MAPBOX / MAPS PLATFORM CONFIGURATION
# =============================================================================
# Mapbox public access token (for client-side tile rendering and geocoding)
VITE_MAPBOX_ACCESS_TOKEN=

# =============================================================================
# SMS & OTP GATEWAY (TWILIO / AFRICA'S TALKING)
# =============================================================================
# Standard Twilio credentials for SMS dispatch & OTP authentication
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =============================================================================
# DATABASE & AUTHENTICATION (SUPABASE / FIREBASE / POSTGRESQL)
# =============================================================================
# Supabase project URL and keys
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Or Firebase Project credentials
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# =============================================================================
# PAYMENT GATEWAYS (CLICKNPAY / OPENAPI.AFRICA & LOCAL CHANNELS)
# =============================================================================
# ClicknPay / OpenAPI.Africa (Unified African Gateway for EcoCash, OneMoney, InnBucks, Zimswitch & Cards)
# Developer portal: https://openapi.africa/#/developers
CLICKNPAY_API_KEY=
CLICKNPAY_MERCHANT_ID=
CLICKNPAY_API_URL="https://backendservices.clicknpay.africa:2081"
CLICKNPAY_RETURN_URL=
CLICKNPAY_WEBHOOK_URL=

# Paynow Zimbabwe (Alternative aggregator for EcoCash, OneMoney, InnBucks, ZIPIT, Cards)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=
PAYNOW_RETURN_URL=

# Direct EcoCash Merchant Open API (Cassava)
ECOCASH_MERCHANT_ID=
ECOCASH_API_KEY=
ECOCASH_API_SECRET=
ECOCASH_ENDPOINT_URL=

# Simbisa InnBucks API
INNBUCKS_API_KEY=
INNBUCKS_MERCHANT_CODE=

# International Card Processing (Stripe / Paystack)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

