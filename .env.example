# =============================================================================
# FRONTEND VARIABLES (PUBLIC UI CONFIG ONLY)
# Supabase and Twilio variables are intentionally backend-only.
# =============================================================================

# 1. Mapbox Maps & Routing
VITE_MAPBOX_ACCESS_TOKEN=""

 # 2. Optional API Base URL (if frontend points to Render backend)
VITE_API_BASE_URL=""

# 3. Firebase Cloud Messaging (Web Push Public VAPID Key)
VITE_FIREBASE_VAPID_KEY=""


# =============================================================================
# BACKEND SERVER VARIABLES (PASTE THESE INTO RENDER WEB SERVICE)
# These are SERVER SECRETS and MUST NEVER be exposed to the browser.
# =============================================================================

NODE_ENV="production"
PORT=3000

# 1. Supabase Server Secret Key (Admin bypass for backend tasks)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# 2. Twilio SMS OTP Gateway (Server Secret)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""

# 3. Firebase Cloud Messaging (FCM) & Push Notifications (Server Secret)
FIREBASE_PROJECT_ID=""
# Either paste full JSON service account string or individual credentials
FIREBASE_SERVICE_ACCOUNT_JSON=""

# 4. Payment Gateway Webhook Secrets (Server Secret)
CLICKNPAY_MERCHANT_ID=""
CLICKNPAY_API_KEY=""
CLICKNPAY_WEBHOOK_SECRET=""
CLICKNPAY_API_URL="https://backendservices.clicknpay.africa:2081"

# 5. Gemini AI Secret Key
GEMINI_API_KEY=""
